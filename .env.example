# --- LLM (OpenAI) --- https://platform.openai.com/api-keys
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4.1-mini
# client-side requests per minute
LLM_RPM=300
# USD per 1M tokens of LLM_MODEL, used to estimate cost per ticket
PRICE_INPUT_PER_M=0.15
PRICE_OUTPUT_PER_M=0.60

# --- Embedding & reranker ---
EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536
# bge = local cross-encoder BAAI/bge-reranker-v2-m3 (needs torch) | llm = LLM scoring | none
RERANKER=bge

# --- Retrieval ---
CHUNK_CHARS=300
TOP_K_RETRIEVE=20
TOP_K_CONTEXT=6
CRAG_MAX_ROUNDS=3

# --- UI ---
API_URL=http://localhost:8000
